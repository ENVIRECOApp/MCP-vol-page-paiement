# Copier ce fichier en ".env" pour un lancement local. Ne jamais versionner ".env".

# Clé Duffel : duffel_test_... pour les essais, duffel_live_... en production.
DUFFEL_API_KEY=duffel_test_xxxxxxxx

# Personal Access Token Airtable limité à la base ENVIRECO, avec les scopes
# data.records:read et data.records:write.
AIRTABLE_TOKEN=patxxxxxxxx
AIRTABLE_BASE_ID=appOaaEm9hZALEfBz

# Mot de passe demandé lors de la connexion du connecteur dans ChatGPT (12 caractères min.).
MCP_LOGIN_PASSWORD=

# Secret de signature des jetons (32 caractères min.), par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# URL publique du serveur, sans barre finale.
PUBLIC_BASE_URL=http://localhost:8000

# Optionnel — valeurs par défaut :
# PORT=8000
# AIRTABLE_TABLE_RESERVATIONS=tbltvki9dN6XI1geN
# AIRTABLE_TABLE_PASSAGERS=Coordonnees_passager_vol
# Hôtes acceptés comme adresse de retour OAuth (ajouter "localhost" pour MCP Inspector).
# OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,chat.openai.com
